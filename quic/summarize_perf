"""Produce a text/markdown performance summary.

Same interface as plot_perf (-b/-n) but requires no matplotlib, seaborn,
or pandas dependencies.

Usage:
    ./summarize_perf -b baseline.json -n new.json
    ./summarize_perf -b baseline.json -n new.json -o perf-summary.md
"""

import argparse
import sys

from perf_analysis import (
    load_results,
    extract_durs,
    extract_effs,
    review_suites,
    sorted_cases,
    format_text_summary,
)

if __name__ == '__main__':
    parser = argparse.ArgumentParser(
        description='Produce a text/markdown performance summary',
        formatter_class=argparse.ArgumentDefaultsHelpFormatter)
    parser.add_argument('-b', '--baseline', type=str,
        help='Baseline results file',
        required=True)
    parser.add_argument('-n', '--new', type=str,
        help='New results file',
        required=True)
    parser.add_argument('-o', '--output', type=str,
        help='Output file (default: stdout)',
        default=None)

    args = parser.parse_args()
    old = load_results(args.baseline)
    new = load_results(args.new)

    base_durs = extract_durs(old)
    new_durs = extract_durs(new)
    base_eff = extract_effs(old)
    new_eff = extract_effs(new)

    common_success, messages = review_suites(old, new)
    cases = sorted_cases(common_success, base_durs)

    summary = format_text_summary(old, new, base_durs, new_durs,
                                  base_eff, new_eff, common_success,
                                  cases, messages)

    if args.output:
        with open(args.output, 'w') as f:
            f.write(summary)
    else:
        print(summary)
