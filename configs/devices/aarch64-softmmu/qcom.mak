# Include default config
include default.mak

# Qualcomm virt board
CONFIG_QCOM_VIRT=y

# Graphics device
CONFIG_QCOM_GRAPHICS=y
# CRM v2 device
CONFIG_QCOM_CRM_V2=y
# CMD DB
CONFIG_QCOM_CMD_DB=y
# RPMh RSC
CONFIG_QCOM_RPMH_RSC=y
# RPMh clock
CONFIG_QCOM_RPMH_CLK=y
# ICC RPMh
CONFIG_QCOM_ICC_RPMH=y

# CC devices
CONFIG_QCOM_CC=y
