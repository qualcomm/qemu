EXTINSN(V6_vmpyiewuh_acc,"Vx32.w+=vmpyie(Vu32.w,Vv32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Word by Halfword Multiply",
