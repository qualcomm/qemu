Q6INSN(V6_vscattermwh_add_alt,"vscatter(Rt32,Mu2,Vvv32.w)+=Vw32.h",ATTRIBS(A_MAPPING,A_CVI),"Mapping from vscatter(Rt32,Mu2,Vvv32.w)+=Vw32.h to vscatter(Rt32,Mu2,Vvv32.w).h+=Vw32",
fASM_MAP("vscatter(Rt32,Mu2,Vvv32.w)+=Vw32.h","vscatter(Rt32,Mu2,Vvv32.w).h+=Vw32"))

Q6INSN(V6_vscattermh_add_alt,"vscatter(Rt32,Mu2,Vv32.h)+=Vw32.h",ATTRIBS(A_MAPPING,A_CVI),"Mapping from vscatter(Rt32,Mu2,Vv32.h)+=Vw32.h to vscatter(Rt32,Mu2,Vv32.h).h+=Vw32",
fASM_MAP("vscatter(Rt32,Mu2,Vv32.h)+=Vw32.h","vscatter(Rt32,Mu2,Vv32.h).h+=Vw32"))

Q6INSN(V6_vscattermwq_alt,"if (Qs4) vscatter(Rt32,Mu2,Vv32.w)=Vw32.w",ATTRIBS(A_MAPPING,A_CVI),"Mapping from if (Qs4) vscatter(Rt32,Mu2,Vv32.w)=Vw32.w to if (Qs4) vscatter(Rt32,Mu2,Vv32.w).w=Vw32",
