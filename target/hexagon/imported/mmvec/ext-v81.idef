Q6INSN(V6_vscattermwhq_alt,"if (Qs4) vscatter(Rt32,Mu2,Vvv32.w)=Vw32.h",ATTRIBS(A_MAPPING,A_CVI),"Mapping from if (Qs4) vscatter(Rt32,Mu2,Vvv32.w)=Vw32.h to if (Qs4) vscatter(Rt32,Mu2,Vvv32.w).h=Vw32",
fASM_MAP("if (Qs4) vscatter(Rt32,Mu2,Vvv32.w)=Vw32.h","if (Qs4) vscatter(Rt32,Mu2,Vvv32.w).h=Vw32"))

Q6INSN(V6_vscattermhq_alt,"if (Qs4) vscatter(Rt32,Mu2,Vv32.h)=Vw32.h",ATTRIBS(A_MAPPING,A_CVI),"Mapping from if (Qs4) vscatter(Rt32,Mu2,Vv32.h)=Vw32.h to if (Qs4) vscatter(Rt32,Mu2,Vv32.h).h=Vw32",
fASM_MAP("if (Qs4) vscatter(Rt32,Mu2,Vv32.h)=Vw32.h","if (Qs4) vscatter(Rt32,Mu2,Vv32.h).h=Vw32"))

EXTINSN(V6_vprefixqb,"Vd32.b=prefixsum(Qv4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_CVI_EARLY,A_RESTRICT_CVI_NOVP,A_NOTE_RESTRICT_CVI_NOVP),"parallel prefix sum of Q into byte",
{ fHIDE(int i;) fHIDE(size1u_t acc = 0;) fVFOREACH(8, i) { acc += fGETQBIT(QvV,i); VdV.ub[i] = acc; } })

EXTINSN(V6_vprefixqh,"Vd32.h=prefixsum(Qv4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_CVI_EARLY,A_RESTRICT_CVI_NOVP,A_NOTE_RESTRICT_CVI_NOVP),"parallel prefix sum of Q into halfwords",
{ fHIDE(int i;) fHIDE(size2u_t acc = 0;) fVFOREACH(16, i) { acc += fGETQBIT(QvV,i*2+0); acc += fGETQBIT(QvV,i*2+1); VdV.uh[i] = acc; } })

EXTINSN(V6_vprefixqw,"Vd32.w=prefixsum(Qv4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_CVI_EARLY,A_RESTRICT_CVI_NOVP,A_NOTE_RESTRICT_CVI_NOVP),"parallel prefix sum of Q into words",
{ fHIDE(int i;) fHIDE(size4u_t acc = 0;) fVFOREACH(32, i) { acc += fGETQBIT(QvV,i*4+0); acc += fGETQBIT(QvV,i*4+1); acc += fGETQBIT(QvV,i*4+2); acc += fGETQBIT(QvV,i*4+3); VdV.uw[i] = acc; } })

EXTINSN(V6_pv32,"pv32(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>2;i++) { fprintf(stdout,"%08x ", VuV.uw[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv32d,"pv32d(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>2;i++) { fprintf(stdout,"%10d ", VuV.w[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv32du,"pv32du(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>2;i++) { fprintf(stdout,"%10u ", VuV.uw[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv64d,"pv64d(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>4;i++) { fprintf(stdout,"%lli ", VuV.ud[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv16,"pv16(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>1;i++) { fprintf(stdout,"%04x ", VuV.uh[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv16d,"pv16d(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>1;i++) { fprintf(stdout,"%5d ", VuV.h[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv8d,"pv8d(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>0;i++) { fprintf(stdout,"%3u ", VuV.ub[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_pv8,"pv8(Vu32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a Vector",
{ int i; size4u_t vec_len = fVBYTES(); fprintf(stdout,"V%2d:     ",VuN); for (i=0;i<vec_len>>0;i++) { fprintf(stdout,"%02x ", VuV.ub[i]); }; fprintf(stdout,"\\n"); fprintf(stdout,"V_ext%2d: ",VuN); for (i=0;i<32;i++) { fprintf(stdout,"%08x ", GET_VEXT(VuV,i,32)); }; fprintf(stdout,"\\n"); fflush(stdout);})

EXTINSN(V6_preg,"preg(Ru32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a scalar",
{ printf("R%02d=0x%08x\\n", RuN, RuV);})

EXTINSN(V6_pregd,"pregd(Ru32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a scalar",
{ printf("R%02d=%10d\\n", RuN, RuV); })

EXTINSN(V6_pregf,"pregf(Ru32)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a scalar",
{ printf("R%02d=%f\\n", RuN, (float)RuV); })

EXTINSN(V6_pz,"pz(Zu2)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print a scalar",
{ fprintf(stdout,"Z%d:\\n", ZuN); for(int m=0, l=0; l < fVBYTES()/4/8; l++) { fprintf(stdout,"\\t"); for(int k = 0; k < 8; k++,m++) fprintf(stdout,"%x ", ZuV.w[m]); fprintf(stdout,"\\n"); } fprintf(stdout,"\\n"); fflush(stdout); })

EXTINSN(V6_ppred,"ppred(Qs4)",ATTRIBS(A_EXTENSION,A_CVI,A_VDBG,A_FAKEINSN),"Print Predicates",
int j; fprintf(stdout,"Q%d: [",QsN); for (j = 0; j < fVBYTES()-1; j++){ fprintf(stdout,"%1x,", fGETQBIT(QsV,j)); } fprintf(stdout,"%1x", fGETQBIT(QsV,j)); fprintf(stdout,"]\\n"); fflush(stdout);)

