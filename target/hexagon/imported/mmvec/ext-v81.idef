{ fHIDE(int i;) fVFOREACH(32, i) { fCONVERT_F8_TO_QF16(VddV,0,2*i,VuV.f8[4*i]) fCONVERT_F8_TO_QF16(VddV,1,2*i,VuV.f8[4*i+1]) fCONVERT_F8_TO_QF16(VddV,0,2*i+1,VuV.f8[4*i+2]) fCONVERT_F8_TO_QF16(VddV,1,2*i+1,VuV.f8[4*i+3]) ; } })

EXTINSN(V6_vconv_f8_qf16,"Vd32.f8=Vu32.qf16",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Vector convert qf16 to f8",
