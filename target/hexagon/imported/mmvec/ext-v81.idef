EXTINSN(V6_valignb,"Vd32=valign(Vu32,Vv32,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE,A_NOTE_RT8),"Align Two vectors by Rt8 as control",
{ unsigned shift = RtV & (fVBYTES()-1); fHIDE(int i;) for(i = 0; i < fVBYTES(); i++) { VdV.ub[i] = (i+shift>=fVBYTES()) ? VuV.ub[i+shift-fVBYTES()] : VvV.ub[i+shift]; } })

EXTINSN(V6_vlalignb,"Vd32=vlalign(Vu32,Vv32,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE,A_NOTE_RT8),"Align Two vectors by Rt8 as control",
{ unsigned shift = fVBYTES() - (RtV & (fVBYTES()-1)); fHIDE(int i;) for(i = 0; i < fVBYTES(); i++) { VdV.ub[i] = (i+shift>=fVBYTES()) ? VuV.ub[i+shift-fVBYTES()] : VvV.ub[i+shift]; } })

EXTINSN(V6_valignbi,"Vd32=valign(Vu32,Vv32,#u3)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Align Two vectors by #u3 as control",
{ fHIDE(int i;) for(i = 0; i < fVBYTES(); i++) { VdV.ub[i] = (i+uiV>=fVBYTES()) ? VuV.ub[i+uiV-fVBYTES()] : VvV.ub[i+uiV]; } })

EXTINSN(V6_vlalignbi,"Vd32=vlalign(Vu32,Vv32,#u3)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Align Two vectors by #u3 as control",
{ unsigned shift = fVBYTES() - uiV; fHIDE(int i;) for(i = 0; i < fVBYTES(); i++) { VdV.ub[i] = (i+shift>=fVBYTES()) ? VuV.ub[i+shift-fVBYTES()] : VvV.ub[i+shift]; } })

EXTINSN(V6_valign4,"Vd32=valign4(Vu32,Vv32,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE,A_NOTE_RT8),"In-lane align two vectors by Rt8 as control",
{ fHIDE(int i;) fVFOREACH(32, i) { unsigned shift = 8 * (RtV & 0x3); VdV.uw[i] = (VuV.uw[i] << shift) | (VvV.uw[i] >> (32-shift)); } })

EXTINSN(V6_vror,"Vd32=vror(Vu32,Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Align Two vectors by Rt32 as control",
{ fHIDE(int k;) for (k=0;k<fVBYTES();k++) { VdV.ub[k] = VuV.ub[(k+RtV)&(fVBYTES()-1)]; } })

EXTINSN(V6_vunpackub,"Vdd32.uh=vunpack(Vu32.ub)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"Unpack byte with zero-extend",
{ fHIDE(int i;) fVFOREACH(8, i) { fVARRAY_ELEMENT_ACCESS(VddV, uh, i) = fZE8_16( VuV.ub[i]); } })

EXTINSN(V6_vunpackb,"Vdd32.h=vunpack(Vu32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"Unpack bytes with sign-extend",
{ fHIDE(int i;) fVFOREACH(8, i) { fVARRAY_ELEMENT_ACCESS(VddV, h, i) = fSE8_16( VuV.b[i] ); } })

EXTINSN(V6_vunpackuh,"Vdd32.uw=vunpack(Vu32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"Unpack halves with zero-extend",
{ fHIDE(int i;) fVFOREACH(16, i) { fVARRAY_ELEMENT_ACCESS(VddV, uw, i) = fZE16_32(VuV.uh[i]); } })

EXTINSN(V6_vunpackh,"Vdd32.w=vunpack(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"Unpack halves with sign-extend",
{ fHIDE(int i;) fVFOREACH(16, i) { fVARRAY_ELEMENT_ACCESS(VddV, w, i) = fSE16_32(VuV.h[i] ); } })

EXTINSN(V6_vunpackob,"Vxx32.h|=vunpacko(Vu32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"Unpack byte to odd bytes ",
{ fHIDE(int i;) fVFOREACH(8, i) { fVARRAY_ELEMENT_ACCESS(VxxV, uh, i) |= fZE8_16( VuV.ub[i])<<8; } })

EXTINSN(V6_vunpackoh,"Vxx32.w|=vunpacko(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"Unpack halves to odd halves",
{ fHIDE(int i;) fVFOREACH(16, i) { fVARRAY_ELEMENT_ACCESS(VxxV, uw, i) |= fZE16_32(VuV.uh[i])<<16; } })

EXTINSN(V6_vpackeb,"Vd32.b=vpacke(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Pack  bytes",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.ub[i] = fGETUBYTE(0, VvV.uh[i]); VdV.ub[i+fVELEM(16)] = fGETUBYTE(0, VuV.uh[i]) ; } })

EXTINSN(V6_vpackeh,"Vd32.h=vpacke(Vu32.w,Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Pack  halfwords",
