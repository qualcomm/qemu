EXTINSN(V6_vlutvvb_nm,"Vd32.b=vlut32(Vu32.b,Vv32.b,Rt8):nomatch",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"vector-vector table lookup",
{ fHIDE(int i;) fVFOREACH(8, i) { fHIDE(fRT8NOTE()) fHIDE(unsigned int idx;) fHIDE(int oddhalf;) fHIDE(int matchval;) matchval = RtV & 0x7; oddhalf = (RtV >> (fVECLOGSIZE()-6)) & 0x1; idx = VuV.ub[i]; idx = (idx&0x1F) | (matchval<<5); VdV.b[i] = fGETBYTE(oddhalf,VvV.h[idx % fVELEM(16)]);; } })

EXTINSN(V6_vlutvwh_nm,"Vdd32.h=vlut16(Vu32.b,Vv32.h,Rt8):nomatch",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"vector-vector table lookup",
