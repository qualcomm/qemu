EXTINSN(V6_vdmpybus,"Vd32.h=vdmpy(Vu32.ub, Rt32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE),"Vector Dual Multiply-Accumulates unsigned bytes by bytes",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.h[i] = fMPY8US( fGETUBYTE(0, VuV.uh[i]), fGETBYTE((2*i) % 4, RtV)); VdV.h[i] += fMPY8US( fGETUBYTE(1, VuV.uh[i]), fGETBYTE((2*i+1)%4, RtV)) ; } })

EXTINSN(V6_vdmpybus_acc,"Vx32.h+=vdmpy(Vu32.ub, Rt32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE),"Vector Dual Multiply-Accumulates unsigned bytes by  bytes, and accumulate",
