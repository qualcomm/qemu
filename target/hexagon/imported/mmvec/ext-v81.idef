EXTINSN(V6_vmpyewuh_64,"Vdd32=vmpye(Vu32.w,Vv32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Word times Halfword Multiply, 64-bit result",
{ fHIDE(int i;) fVFOREACH(32, i) { fHIDE(size8s_t prod;) prod = fMPY32SU(VuV.w[i],fGETUHALF(0,VvV.w[i])); VddV.v[1].w[i] = prod >> 16; VddV.v[0].w[i] = prod << 16; ; } })

EXTINSN(V6_vmpyowh_64_acc,"Vxx32+=vmpyo(Vu32.w,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Word times Halfword Multiply, 64-bit result",
{ fHIDE(int i;) fVFOREACH(32, i) { fHIDE(size8s_t prod;) prod = fMPY32SS(VuV.w[i],fGETHALF(1,VvV.w[i])) + fSE32_64(VxxV.v[1].w[i]); VxxV.v[1].w[i] = prod >> 16; fSETHALF(0, VxxV.v[0].w[i], VxxV.v[0].w[i] >> 16); fSETHALF(1, VxxV.v[0].w[i], prod & 0x0000ffff); ; } })

EXTINSN(V6_vmpyowh_sacc,"Vx32.w+=vmpyo(Vu32.w,Vv32.h):<<1:sat:shift",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(32, i) { VxV.w[i] = fVSATW(((((VxV.w[i] + fMPY3216SS(VuV.w[i], fGETHALF(1, VvV.w[i]))) >> 14) + 0) >> 1)); } })

EXTINSN(V6_vmpyowh_rnd_sacc,"Vx32.w+=vmpyo(Vu32.w,Vv32.h):<<1:rnd:sat:shift",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(32, i) { VxV.w[i] = fVSATW(((((VxV.w[i] + fMPY3216SS(VuV.w[i], fGETHALF(1, VvV.w[i]))) >> 14) + 1) >> 1)); } })

EXTINSN(V6_vmpyieoh,"Vd32.w=vmpyieo(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE),"Odd/Even multiply for 32x32 low half",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = (fGETHALF(0,VuV.w[i])*fGETHALF(1,VvV.w[i])) << 16; } })

EXTINSN(V6_vmpyiewuh,"Vd32.w=vmpyie(Vu32.w,Vv32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Word by Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = fMPY3216SU(VuV.w[i], fGETUHALF(0, VvV.w[i])); } })

EXTINSN(V6_vmpyiowh,"Vd32.w=vmpyio(Vu32.w,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Word by Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = fMPY3216SS(VuV.w[i], fGETHALF(1, VvV.w[i])); } })

EXTINSN(V6_vmpyiewh_acc,"Vx32.w+=vmpyie(Vu32.w,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Word by Halfword Multiply",
