EXTINSN(V6_vsh,"Vdd32.w=vsxt(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Sign Extend halfwords",
