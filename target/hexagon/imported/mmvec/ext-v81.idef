EXTINSN(V6_vmpyuhe_acc,"Vx32.uw+=vmpye(Vu32.uh,Rt32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE),"Vector even halfword unsigned multiply by scalar",
