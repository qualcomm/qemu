EXTINSN(V6_vmpyowh,"Vd32.w=vmpyo(Vu32.w,Vv32.h):<<1:sat",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = fVSATW((((fMPY3216SS(VuV.w[i], fGETHALF(1, VvV.w[i])) >> 14) + 0) >> 1)); } })

EXTINSN(V6_vmpyowh_rnd,"Vd32.w=vmpyo(Vu32.w,Vv32.h):<<1:rnd:sat",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
