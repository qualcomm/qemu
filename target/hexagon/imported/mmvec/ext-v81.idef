EXTINSN(V6_vzh,"Vdd32.uw=vzxt(Vu32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Zero Extend halfwords",
