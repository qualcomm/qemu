EXTINSN(V6_vdmpyhb_acc,"Vx32.w+=vdmpy(Vu32.h,Rt32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE),"Dual-Vector 2-Element Half x Byte Reduction with Sliding Window Overlap",
