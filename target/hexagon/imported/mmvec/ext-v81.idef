{ fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unfloat )u = fPARSEQF_EXT(16,VuV,i); if(is_unfloat_neg(u)) u.sign = !u.sign; INIT_UNFLOAT(v) v.exp = E_MIN_EXTQF16; v.sign = 1; fQFADD(16,VdV,u,v) fHIDE(check_vabs_compliance(EXTQF16,EXTQF16,VuV.qf16[i],GET_VEXT(VuV,i,16),VdV.qf16[i],GET_VEXT(VdV,i,16),false);) ; } })

