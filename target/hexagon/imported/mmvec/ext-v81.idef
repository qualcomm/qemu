EXTINSN(V6_vconv_bf_qf32,"Vd32.bf=Vuu32.qf32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Vector conversion of double qf32 to BF",
{ fHIDE(int i;) fVFOREACH(32, i) { if(fBF16_SUPPORTED()) { VdV.bf[2*i] = fCONVERT_QF32_TO_BF(VuuV.v[0].qf32[i], GET_VEXT_PAIR(VuuV,0,i,32)); VdV.bf[2*i+1] = fCONVERT_QF32_TO_BF(VuuV.v[1].qf32[i], GET_VEXT_PAIR(VuuV,1,i,32)); fHIDE(check_narrowing_vconv_compliance(EXTQF32,BF,VuuV.v[0].qf32[i],GET_VEXT_PAIR(VuuV,0,i,32),VdV.bf[2*i],0);) fHIDE(check_narrowing_vconv_compliance(EXTQF32,BF,VuuV.v[1].qf32[i],GET_VEXT_PAIR(VuuV,1,i,32),VdV.bf[2*i+1],0);) } else { VdV.hf[2*i] = fCONVERT_QF32_TO_HF(VuuV.v[0].qf32[i], GET_VEXT_PAIR(VuuV,0,i,32)); VdV.hf[2*i+1] = fCONVERT_QF32_TO_HF(VuuV.v[1].qf32[i], GET_VEXT_PAIR(VuuV,1,i,32)); } ; } })

