EXTINSN(V6_vmpyih,"Vd32.h=vmpyi(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.h[i] = fMPY16SS(VuV.h[i], VvV.h[i]); } })

EXTINSN(V6_vmpyih_acc,"Vx32.h+=vmpyi(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
{ fHIDE(int i;) fVFOREACH(16, i) { VxV.h[i] += fMPY16SS(VuV.h[i], VvV.h[i]); } })

EXTINSN(V6_vmpyewuh,"Vd32.w=vmpye(Vu32.w,Vv32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector by Vector Halfword Multiply",
