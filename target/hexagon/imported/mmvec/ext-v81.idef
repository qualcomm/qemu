Q6INSN(V6_stup0,"if (Pv4) vmemu(Rt32)=Vs32",ATTRIBS(A_MAPPING,A_CVI),"Mapping from if (Pv4) vmemu(Rt32)=Vs32 to if (Pv4) vmemu(Rt32+#0)=Vs32",
