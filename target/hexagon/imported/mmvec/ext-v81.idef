EXTINSN(V6_vabsdiffub,"Vd32.ub=vabsdiff(Vu32.ub,Vv32.ub)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE),"Vector Absolute of Difference Unsigned Byte",
