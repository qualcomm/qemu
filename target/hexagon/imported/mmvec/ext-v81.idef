EXTINSN(V6_vaddubh_acc,"Vxx32.h+=vadd(Vu32.ub,Vv32.ub)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Vector addition with widen into two vectors",
