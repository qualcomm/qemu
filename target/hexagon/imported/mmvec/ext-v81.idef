EXTINSN(V6_vpackob,"Vd32.b=vpacko(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Pack  bytes",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.ub[i] = fGETUBYTE(1, VvV.uh[i]); VdV.ub[i+fVELEM(16)] = fGETUBYTE(1, VuV.uh[i]) ; } })

EXTINSN(V6_vpackoh,"Vd32.h=vpacko(Vu32.w,Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Pack  halfwords",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.uh[i] = fGETUHALF(1, VvV.uw[i]); VdV.uh[i+fVELEM(32)] = fGETUHALF(1, VuV.uw[i]) ; } })

EXTINSN(V6_vpackhub_sat,"Vd32.ub=vpack(Vu32.h,Vv32.h):sat",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Pack ubytes with saturation",
