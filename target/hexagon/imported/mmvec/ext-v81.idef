EXTINSN(V6_vmin_bf,"Vd32.bf=vmin(Vu32.bf,Vv32.bf)",ATTRIBS(A_EXTENSION,A_HVX_IEEE_FP,A_NOTE_HVX_IEEE_FP,A_CVI,A_CVI_VX,A_HVX_IEEE_FP_OUT_16,A_HVX_IEEE_FP_OUT_32,A_CVI_LATE),"DESCR",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.bf[i] = fCHECK_IEEE_RESOURCE(fp_min_bf(VuV.bf[i], VvV.bf[i])); fBFLOAT(); } })

EXTINSN(V6_vscattermhwq,"if (Qs4) vscatter(Rt32,Mu2,Vvv32.w).h=Vw32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_SCATTER,A_CVI_VA_DV,A_CVI_VM,A_EA_PAGECROSS,A_MEMSIZE_2B,A_CVI_GATHER_ADDR_4B,A_VTCM_ALLBANK_ACCESS,A_MEMLIKE,A_NOTE_ANY2_RESOURCE),"Scatter halfwords conditional",
{ fHIDE(int i;) fHIDE(int j;) fHIDE(int element_size = 2;) fHIDE(fSCATTER_INIT( RtV, MuV, element_size);) fVLASTBYTE(MuV, element_size); fVALIGN(RtV, element_size); fVFOREACH(32, i) { for(j = 0; j < 2; j++) { EA = RtV+VvvV.v[j].uw[i]; fVLOG_VTCM_HALFWORDQ_DV(EA,VvvV.v[j].uw[i],VwV,(2*i+j),QsV,i,j,MuV); } } fSCATTER_FINISH(0) })

EXTINSN(V6_vscattermhw_add,"vscatter(Rt32,Mu2,Vvv32.w).h+=Vw32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_SCATTER,A_CVI_VA_DV,A_CVI_VM,A_EA_PAGECROSS,A_MEMSIZE_2B,A_CVI_GATHER_ADDR_4B,A_CVI_SCATTER_ACC,A_VTCM_ALLBANK_ACCESS,A_MEMLIKE,A_NOTE_ANY2_RESOURCE),"Scatter halfwords-add",
{ fHIDE(int i;) fHIDE(int j;) fHIDE(int ALIGNMENT=2;) fHIDE(int element_size = 2;) fHIDE(fSCATTER_INIT( RtV, MuV, element_size);) fVLASTBYTE(MuV, element_size); fVALIGN(RtV, element_size); fVFOREACH(32, i) { for(j = 0; j < 2; j++) { EA = RtV + fVALIGN(VvvV.v[j].uw[i],ALIGNMENT);; fVLOG_VTCM_HALFWORD_INCREMENT_DV(EA,VvvV.v[j].uw[i],VwV,(2*i+j),i,j,ALIGNMENT,MuV); } } fHIDE(fLOG_SCATTER_OP(2);) fSCATTER_FINISH(1) })

Q6INSN(V6_vscattermw_alt,"vscatter(Rt32,Mu2,Vv32.w)=Vw32.w",ATTRIBS(A_MAPPING,A_CVI),"Mapping from vscatter(Rt32,Mu2,Vv32.w)=Vw32.w to vscatter(Rt32,Mu2,Vv32.w).w=Vw32",
fASM_MAP("vscatter(Rt32,Mu2,Vv32.w)=Vw32.w","vscatter(Rt32,Mu2,Vv32.w).w=Vw32"))

