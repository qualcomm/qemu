EXTINSN(V6_vpackwh_sat,"Vd32.h=vpack(Vu32.w,Vv32.w):sat",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Pack bytes with saturation",
