EXTINSN(V6_vlut4,"Vd32.h=vlut4(Vu32.uh,Rtt32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_CVI_EARLY,A_RESTRICT_SLOT2ONLY,A_NOTE_MPYDV_RESOURCE),"4 entry lookup table",
