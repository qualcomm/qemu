EXTINSN(V6_vmax_sf,"Vd32.sf=vmax(Vu32.sf,Vv32.sf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector max of sf input",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.sf[i] = fMAX_SF(VuV.sf[i], VvV.sf[i]); } })

EXTINSN(V6_vmin_sf,"Vd32.sf=vmin(Vu32.sf,Vv32.sf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector min of sf input",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.sf[i] = fMIN_SF(VuV.sf[i], VvV.sf[i]); } })

EXTINSN(V6_vmax_hf,"Vd32.hf=vmax(Vu32.hf,Vv32.hf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector max of hf input",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.hf[i] = fMAX_HF(VuV.hf[i], VvV.hf[i]); } })

EXTINSN(V6_vmin_hf,"Vd32.hf=vmin(Vu32.hf,Vv32.hf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector min of hf input",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.hf[i] = fMIN_HF(VuV.hf[i], VvV.hf[i]); } })

EXTINSN(V6_pred_scalar2,"Qd4=vsetq(Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Set Vector Predicate ",
{ fHIDE(int i;) for(i = 0; i < fVBYTES(); i++) fSETQBIT(QdV,i,(i < (RtV & (fVBYTES()-1))) ? 1 : 0); })

EXTINSN(V6_pred_scalar2v2,"Qd4=vsetq2(Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Set Vector Predicate ",
{ fHIDE(int i;) for(i = 0; i < fVBYTES(); i++) fSETQBIT(QdV,i,(i <= ((RtV-1) & (fVBYTES()-1))) ? 1 : 0); })

EXTINSN(V6_vmpy_rt_sf,"Vd32.qf32=vmpy(Vu32.sf,Rt32.sf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Qfloat32 multiply with scalar and sf input",
{ fHIDE(int i;) fVFOREACH(32, i) { fHIDE(unfloat )u = fPARSESF(VuV.sf[i]); fHIDE(unfloat )v = fPARSESF(RtV); fQFMPY(32,VdV,u,v) ; } })

EXTINSN(V6_vmpy_rt_qf16,"Vd32.qf16=vmpy(Vu32.qf16,Rt32.hf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Qfloat16 multiply with scalar and qf16 input",
{ fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unfloat )u = fPARSEQF_EXT(16,VuV,i); fHIDE(unfloat )v = fPARSEHF((RtV >> ((i%2)*16)) & 0xFFFF); fQFMPY(16,VdV,u,v) ; } })

EXTINSN(V6_vmpy_rt_hf,"Vd32.qf16=vmpy(Vu32.hf,Rt32.hf)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX_DV,A_NOTE_MPYDV_RESOURCE),"Qfloat16 multiply with scalar and hf input",
{ fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unfloat )u = fPARSEHF(VuV.hf[i]); fHIDE(unfloat )v = fPARSEHF((RtV >> ((i%2)*16)) & 0xFFFF); fQFMPY(16,VdV,u,v) ; } })

EXTINSN(V6_get_qfext_oracc,"Vx32|=vgetqfext(Vu32.x,Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_XQFLOAT,A_HVX_FLT,A_NOTE_MPY_RESOURCE),"Store with extended bits of a vreg into QReg",
{ fHIDE(int i;) fVFOREACH(8, i) { VxV.ub[i] |= fGETQFEXT_BIT(VuV,i) ? fGETUBYTE(i % 4, RtV) : 0; } })

EXTINSN(V6_get_qfext,"Vd32=vgetqfext(Vu32.x,Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_HVX_FLT,A_XQFLOAT,A_NOTE_MPY_RESOURCE),"Store with extended bits of a vreg into QReg",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = fGETQFEXT_BIT(VuV,i) ? fGETUBYTE(i % 4, RtV) : 0; } })

EXTINSN(V6_set_qfext,"Vd32.x=vsetqfext(Vu32,Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_HVX_FLT,A_XQFLOAT,A_NOTE_MPY_RESOURCE),"Load extended bits of Vreg using QReg",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQFEXT_BIT(VdV,i,((VuV.ub[i] & fGETUBYTE(i % 4, RtV)) != 0) ? 1 : 0); } })

EXTINSN(V6_vmerge_qf,"Vd32=vmerge(Vu32.x,Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_HVX_FLT,A_XQFLOAT,A_NOTE_SHIFT_RESOURCE),"Merge 32 bit word and 4 bit extended bits",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.uw[i] = VvV.uw[i]; SET_VEXT(VdV,i,32,GET_VEXT(VuV,i,32)); } })

EXTINSN(V6_shuffeqw,"Qd4.h=vshuffe(Qs4.w,Qt4.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Shrink Predicate",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i, (i & 2) ? fGETQBIT(QsV,i-2) : fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_shuffeqh,"Qd4.b=vshuffe(Qs4.h,Qt4.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Shrink Predicate",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i, (i & 1) ? fGETQBIT(QsV,i-1) : fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_pred_or,"Qd4=or(Qs4,Qt4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Predicate Or",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i,fGETQBIT(QsV,i) || fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_pred_and,"Qd4=and(Qs4,Qt4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Predicate And",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i,fGETQBIT(QsV,i) && fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_pred_xor,"Qd4=xor(Qs4,Qt4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Predicate Xor",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i,fGETQBIT(QsV,i) ^ fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_pred_or_n,"Qd4=or(Qs4,!Qt4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Predicate Or with not",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i,fGETQBIT(QsV,i) || !fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_pred_and_n,"Qd4=and(Qs4,!Qt4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Predicate And  with not",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i,fGETQBIT(QsV,i) && !fGETQBIT(QtV,i) ) ; } })

EXTINSN(V6_pred_not,"Qd4=not(Qs4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector Predicate Not",
{ fHIDE(int i;) fVFOREACH(8, i) { fSETQBIT(QdV,i,!fGETQBIT(QsV,i) ) ; } })

EXTINSN(V6_vcmov,"if (Ps4) Vd32=Vu32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_NOTE_ANY_RESOURCE),"Conditional Mov",
{ if (fLSBOLD(PsV)) { fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = VuV.ub[i]; } } else {CANCEL;}; })

EXTINSN(V6_vncmov,"if (!Ps4) Vd32=Vu32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_NOTE_ANY_RESOURCE),"Conditional Mov",
{ if (fLSBOLDNOT(PsV)) { fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = VuV.ub[i]; } } else {CANCEL;}; })

EXTINSN(V6_vccombine,"if (Ps4) Vdd32=vcombine(Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Conditional Combine",
{ if (fLSBOLD(PsV)) { fHIDE(int i;) fVFOREACH(8, i) { VddV.v[0].ub[i] = VvV.ub[i]; VddV.v[1].ub[i] = VuV.ub[i]; } } else {CANCEL;}; })

EXTINSN(V6_vnccombine,"if (!Ps4) Vdd32=vcombine(Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Conditional Combine",
{ if (fLSBOLDNOT(PsV)) { fHIDE(int i;) fVFOREACH(8, i) { VddV.v[0].ub[i] = VvV.ub[i]; VddV.v[1].ub[i] = VuV.ub[i]; } } else {CANCEL;}; })

EXTINSN(V6_vmux,"Vd32=vmux(Qt4,Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector Select Element 8-bit",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = fGETQBIT(QtV,i) ? VuV.ub[i] : VvV.ub[i]; } })

EXTINSN(V6_vswap,"Vdd32=vswap(Qt4,Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Swap Element 8-bit",
{ fHIDE(int i;) fVFOREACH(8, i) { VddV.v[0].ub[i] = fGETQBIT(QtV,i) ? VuV.ub[i] : VvV.ub[i]; VddV.v[1].ub[i] = !fGETQBIT(QtV,i) ? VuV.ub[i] : VvV.ub[i] ; } })

EXTINSN(V6_vmaxb,"Vd32.b=vmax(Vu32.b,Vv32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  signed byte max",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.b[i] = (VuV.b[i] > VvV.b[i]) ? VuV.b[i] : VvV.b[i]; } })

EXTINSN(V6_vminb,"Vd32.b=vmin(Vu32.b,Vv32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  signed byte min",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.b[i] = (VuV.b[i] < VvV.b[i]) ? VuV.b[i] : VvV.b[i]; } })

EXTINSN(V6_vmaxub,"Vd32.ub=vmax(Vu32.ub,Vv32.ub)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  unsigned byte max",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = (VuV.ub[i] > VvV.ub[i]) ? VuV.ub[i] : VvV.ub[i]; } })

EXTINSN(V6_vminub,"Vd32.ub=vmin(Vu32.ub,Vv32.ub)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  unsigned byte min",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = (VuV.ub[i] < VvV.ub[i]) ? VuV.ub[i] : VvV.ub[i]; } })

EXTINSN(V6_vmaxuh,"Vd32.uh=vmax(Vu32.uh,Vv32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  unsigned halfword max",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.uh[i] = (VuV.uh[i] > VvV.uh[i]) ? VuV.uh[i] : VvV.uh[i]; } })

EXTINSN(V6_vminuh,"Vd32.uh=vmin(Vu32.uh,Vv32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  unsigned halfword min",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.uh[i] = (VuV.uh[i] < VvV.uh[i]) ? VuV.uh[i] : VvV.uh[i]; } })

EXTINSN(V6_vmaxh,"Vd32.h=vmax(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  halfword max",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.h[i] = (VuV.h[i] > VvV.h[i]) ? VuV.h[i] : VvV.h[i]; } })

EXTINSN(V6_vminh,"Vd32.h=vmin(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  halfword min",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.h[i] = (VuV.h[i] < VvV.h[i]) ? VuV.h[i] : VvV.h[i]; } })

EXTINSN(V6_vmaxw,"Vd32.w=vmax(Vu32.w,Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  word max",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = (VuV.w[i] > VvV.w[i]) ? VuV.w[i] : VvV.w[i]; } })

EXTINSN(V6_vminw,"Vd32.w=vmin(Vu32.w,Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Vector  word min",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = (VuV.w[i] < VvV.w[i]) ? VuV.w[i] : VvV.w[i]; } })

EXTINSN(V6_vsathub,"Vd32.ub=vsat(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Saturate and pack 32 halfwords to 32 unsigned bytes, and interleave them",
{ fHIDE(int i;) fVFOREACH(16, i) { fSETBYTE(0, VdV.uh[i], fVSATUB(VvV.h[i])); fSETBYTE(1, VdV.uh[i], fVSATUB(VuV.h[i])) ; } })

EXTINSN(V6_vsatwh,"Vd32.h=vsat(Vu32.w,Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Saturate and pack 16 words to 16 halfwords, and interleave them",
{ fHIDE(int i;) fVFOREACH(32, i) { fSETHALF(0, VdV.w[i], fVSATH(VvV.w[i])); fSETHALF(1, VdV.w[i], fVSATH(VuV.w[i])) ; } })

EXTINSN(V6_vsatuwuh,"Vd32.uh=vsat(Vu32.uw,Vv32.uw)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Saturate and pack 16 words to 16 halfwords, and interleave them",
{ fHIDE(int i;) fVFOREACH(32, i) { fSETHALF(0, VdV.w[i], fVSATUH(VvV.uw[i])); fSETHALF(1, VdV.w[i], fVSATUH(VuV.uw[i])) ; } })

EXTINSN(V6_vshuffeb,"Vd32.b=vshuffe(Vu32.b,Vv32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Shuffle half words with in a lane",
{ fHIDE(int i;) fVFOREACH(16, i) { fSETBYTE(0, VdV.uh[i], fGETUBYTE(0, VvV.uh[i])); fSETBYTE(1, VdV.uh[i], fGETUBYTE(0, VuV.uh[i])) ; } })

EXTINSN(V6_vshuffob,"Vd32.b=vshuffo(Vu32.b,Vv32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Shuffle half words with in a lane",
{ fHIDE(int i;) fVFOREACH(16, i) { fSETBYTE(0, VdV.uh[i], fGETUBYTE(1, VvV.uh[i])); fSETBYTE(1, VdV.uh[i], fGETUBYTE(1, VuV.uh[i])) ; } })

EXTINSN(V6_vshufeh,"Vd32.h=vshuffe(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Shuffle half words with in a lane",
{ fHIDE(int i;) fVFOREACH(32, i) { fSETHALF(0, VdV.uw[i], fGETUHALF(0, VvV.uw[i])); fSETHALF(1, VdV.uw[i], fGETUHALF(0, VuV.uw[i])) ; } })

EXTINSN(V6_vshufoh,"Vd32.h=vshuffo(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_CVI_VA_2SRC,A_NOTE_ANY_RESOURCE),"Shuffle half words with in a lane",
{ fHIDE(int i;) fVFOREACH(32, i) { fSETHALF(0, VdV.uw[i], fGETUHALF(1, VvV.uw[i])); fSETHALF(1, VdV.uw[i], fGETUHALF(1, VuV.uw[i])) ; } })

Q6INSN(V6_vtran2x2_map,"vtrans2x2(Vy32,Vx32,Rt32)",ATTRIBS(A_MAPPING,A_CVI),"Mapping from vtrans2x2(Vy32,Vx32,Rt32) to vshuff(Vy32,Vx32,Rt32)",
fASM_MAP("vtrans2x2(Vy32,Vx32,Rt32)","vshuff(Vy32,Vx32,Rt32)"))

EXTINSN(V6_vshuff,"vshuff(Vy32,Vx32,Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_CVI_EARLY,A_NOTE_SHIFT_RESOURCE),"2x2->2x2 transpose, for multiple data sizes, inplace",
{ fHIDE(int offset;) for (offset=1; offset<fVBYTES(); offset<<=1) { if ( RtV & offset) { fHIDE(int k;) fVFOREACH(8, k) { if (!( k & offset)) { fSWAPB(VyV.ub[k], VxV.ub[k+offset]); } } } } })

EXTINSN(V6_vshuffvdd,"Vdd32=vshuff(Vu32,Vv32,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE,A_NOTE_RT8),"2x2->2x2 transpose for multiple data sizes",
{ fHIDE(int offset;) VddV.v[0] = VvV; VddV.v[1] = VuV; for (offset=1; offset<fVBYTES(); offset<<=1) { if ( RtV & offset) { fHIDE(int k;) fVFOREACH(8, k) { if (!( k & offset)) { fSWAPB(VddV.v[1].ub[k], VddV.v[0].ub[k+offset]); } } } } })

EXTINSN(V6_vdeal,"vdeal(Vy32,Vx32,Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_CVI_EARLY,A_NOTE_SHIFT_RESOURCE)," vector - vector deal - or deinterleave, for multiple data sizes, inplace",
{ fHIDE(int offset;) for (offset=fVBYTES()>>1; offset>0; offset>>=1) { if ( RtV & offset) { fHIDE(int k;) fVFOREACH(8, k) { if (!( k & offset)) { fSWAPB(VyV.ub[k], VxV.ub[k+offset]); } } } } })

EXTINSN(V6_vdealvdd,"Vdd32=vdeal(Vu32,Vv32,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE,A_NOTE_RT8)," vector - vector deal - or deinterleave, for multiple data sizes",
{ fHIDE(int offset;) VddV.v[0] = VvV; VddV.v[1] = VuV; for (offset=fVBYTES()>>1; offset>0; offset>>=1) { if ( RtV & offset) { fHIDE(int k;) fVFOREACH(8, k) { if (!( k & offset)) { fSWAPB(VddV.v[1].ub[k], VddV.v[0].ub[k+offset]); } } } } })

EXTINSN(V6_vshufoeh,"Vdd32.h=vshuffoe(Vu32.h,Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Shuffle half words",
{ fHIDE(int i;) fVFOREACH(32, i) { fSETHALF(0, VddV.v[0].uw[i], fGETUHALF(0, VvV.uw[i])); fSETHALF(1, VddV.v[0].uw[i], fGETUHALF(0, VuV.uw[i])); fSETHALF(0, VddV.v[1].uw[i], fGETUHALF(1, VvV.uw[i])); fSETHALF(1, VddV.v[1].uw[i], fGETUHALF(1, VuV.uw[i])); } })

EXTINSN(V6_vshufoeb,"Vdd32.b=vshuffoe(Vu32.b,Vv32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector Shuffle bytes",
{ fHIDE(int i;) fVFOREACH(16, i) { fSETBYTE(0, VddV.v[0].uh[i], fGETUBYTE(0, VvV.uh[i])); fSETBYTE(1, VddV.v[0].uh[i], fGETUBYTE(0, VuV.uh[i])); fSETBYTE(0, VddV.v[1].uh[i], fGETUBYTE(1, VvV.uh[i])); fSETBYTE(1, VddV.v[1].uh[i], fGETUBYTE(1, VuV.uh[i])); } })

EXTINSN(V6_vdealh,"Vd32.h=vdeal(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Deal Halfwords",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.uh[i ] = fGETUHALF(0, VuV.uw[i]); VdV.uh[i+fVELEM(32)] = fGETUHALF(1, VuV.uw[i]) ; } })

EXTINSN(V6_vdealb,"Vd32.b=vdeal(Vu32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Deal Halfwords",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.ub[i ] = fGETUBYTE(0, VuV.uh[i]); VdV.ub[i+fVELEM(16)] = fGETUBYTE(1, VuV.uh[i]) ; } })

EXTINSN(V6_vdealb4w,"Vd32.b=vdeale(Vu32.b,Vv32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Deal Two Vectors Bytes",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.ub[0+i ] = fGETUBYTE(0, VvV.uw[i]); VdV.ub[fVELEM(32)+i ] = fGETUBYTE(2, VvV.uw[i]); VdV.ub[2*fVELEM(32)+i] = fGETUBYTE(0, VuV.uw[i]); VdV.ub[3*fVELEM(32)+i] = fGETUBYTE(2, VuV.uw[i]) ; } })

EXTINSN(V6_vshuffh,"Vd32.h=vshuff(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Deal Halfwords",
{ fHIDE(int i;) fVFOREACH(32, i) { fSETHALF(0, VdV.uw[i], VuV.uh[i]); fSETHALF(1, VdV.uw[i], VuV.uh[i+fVELEM(32)]) ; } })

EXTINSN(V6_vshuffb,"Vd32.b=vshuff(Vu32.b)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Deal Halfwords",
{ fHIDE(int i;) fVFOREACH(16, i) { fSETBYTE(0, VdV.uh[i], VuV.ub[i]); fSETBYTE(1, VdV.uh[i], VuV.ub[i+fVELEM(16)]) ; } })

EXTINSN(V6_extractw,"Rd32=vextract(Vu32,Rs32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_RESTRICT_NOPACKET,A_CVI_EXTRACT,A_CVI_VA_2SRC,A_NOTE_NOPACKET,A_MEMLIKE,A_RESTRICT_SLOT0ONLY),"Extract an element from a vector to scalar",
fHIDE(warn("RdN=%d VuN=%d RsN=%d RsV=0x%08x widx=%d",RdN,VuN,RsN,RsV,((RsV & (fVBYTES()-1)) >> 2));) RdV = VuV.uw[ (RsV & (fVBYTES()-1)) >> 2]; fHIDE(warn("RdV=0x%08x",RdV);))

Q6INSN(V6_extractw_alt,"Rd32.w=vextract(Vu32,Rs32)",ATTRIBS(A_MAPPING,A_CVI),"Mapping from Rd32.w=vextract(Vu32,Rs32) to Rd32=vextract(Vu32,Rs32)",
fASM_MAP("Rd32.w=vextract(Vu32,Rs32)","Rd32=vextract(Vu32,Rs32)"))

EXTINSN(V6_vinsertwr,"Vx32.w=vinsert(Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_CVI_LATE,A_NOTE_MPY_RESOURCE),"Insert Word Scalar into Vector",
VxV.uw[0] = RtV;)

EXTINSN(V6_lvsplatw,"Vd32=vsplat(Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE,A_CVI_LATE),"Replicates scalar accross words in vector",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.uw[i] = RtV; } })

EXTINSN(V6_lvsplath,"Vd32.h=vsplat(Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE,A_CVI_LATE),"Replicates scalar accross halves in vector",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.uh[i] = RtV; } })

EXTINSN(V6_lvsplatb,"Vd32.b=vsplat(Rt32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VX,A_NOTE_MPY_RESOURCE,A_CVI_LATE),"Replicates scalar accross bytes in vector",
{ fHIDE(int i;) fVFOREACH(8, i) { VdV.ub[i] = RtV; } })

Q6INSN(V6_vassignp,"Vdd32=Vuu32",ATTRIBS(A_MAPPING,A_CVI),"Mapping from Vdd32=Vuu32 to Vdd32=vcombine(Vuu.H32,Vuu.L32)",
fASM_MAP("Vdd32=Vuu32","Vdd32=vcombine(Vuu.H32,Vuu.L32)"))

EXTINSN(V6_vassign,"Vd32=Vu32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA,A_NOTE_ANY_RESOURCE),"Copy a vector",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i]=VuV.w[i]; } })

EXTINSN(V6_vcombine,"Vdd32=vcombine(Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VA_DV,A_NOTE_ANY2_RESOURCE),"Vector assign, Any two to Vector Pair",
{ fHIDE(int i;) fVFOREACH(8, i) { VddV.v[0].ub[i] = VvV.ub[i]; VddV.v[1].ub[i] = VuV.ub[i] ; } })

EXTINSN(V6_vcombine_tmp,"Vdd32.tmp=vcombine(Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_REMAP,A_CVI_TMP,A_NO_INTRINSIC),"Vector assign tmp, Any two to Vector Pair ",
{ fHIDE(int i;) fVFOREACH(8, i) { VddV.v[0].ub[i] = VvV.ub[i]; VddV.v[1].ub[i] = VuV.ub[i]; } fVFOREACH(32, i) { GET_AND_SET_VEXT_PAIR(VddV,0,VvV,i,32); GET_AND_SET_VEXT_PAIR(VddV,1,VuV,i,32); } })

EXTINSN(V6_vassign_tmp,"Vd32.tmp=Vu32",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_REMAP,A_CVI_TMP,A_NO_INTRINSIC),"Vector assign tmp, Any two to Vector Pair ",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i]=VuV.w[i]; GET_AND_SET_VEXT(VdV,VuV,i,32); } })

EXTINSN(V6_vdelta,"Vd32=vdelta(Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Reverse Benes Butterfly network ",
{ fHIDE(int offset;) fHIDE(int k;) for (offset=fVBYTES(); (offset>>=1)>0; ) { for (k = 0; k<fVBYTES(); k++) { VdV.ub[k] = (VvV.ub[k]&offset) ? VuV.ub[k^offset] : VuV.ub[k]; } for (k = 0; k<fVBYTES(); k++) { VuV.ub[k] = VdV.ub[k]; } } })

EXTINSN(V6_vrdelta,"Vd32=vrdelta(Vu32,Vv32)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"Forward Benes Butterfly network ",
{ fHIDE(int offset;) fHIDE(int k;) for (offset=1; offset<fVBYTES(); offset<<=1){ for (k = 0; k<fVBYTES(); k++) { VdV.ub[k] = (VvV.ub[k]&offset) ? VuV.ub[k^offset] : VuV.ub[k]; } for (k = 0; k<fVBYTES(); k++) { VuV.ub[k] = VdV.ub[k]; } } })

EXTINSN(V6_vcl0w,"Vd32.uw=vcl0(Vu32.uw)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Count Leading Zeros in word",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.uw[i]=fCL1_4(~VuV.uw[i]); } })

EXTINSN(V6_vcl0h,"Vd32.uh=vcl0(Vu32.uh)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Count Leading Zeros in halfword",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.uh[i]=fCL1_2(~VuV.uh[i]); } })

EXTINSN(V6_vnormamtw,"Vd32.w=vnormamt(Vu32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Norm Amount Word",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i]=fMAX(fCL1_4(~VuV.w[i]),fCL1_4(VuV.w[i]))-1;; } })

EXTINSN(V6_vnormamth,"Vd32.h=vnormamt(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Norm Amount Halfword",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.h[i]=fMAX(fCL1_2(~VuV.h[i]),fCL1_2(VuV.h[i]))-1;; } })

EXTINSN(V6_vaddclbw,"Vd32.w=vadd(vclb(Vu32.w),Vv32.w)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_CVI_VV_LATE,A_NOTE_SHIFT_RESOURCE),"Count leading bits and add",
{ fHIDE(int i;) fVFOREACH(32, i) { VdV.w[i] = fMAX(fCL1_4(~VuV.w[i]),fCL1_4(VuV.w[i])) + VvV.w[i]; } })

EXTINSN(V6_vaddclbh,"Vd32.h=vadd(vclb(Vu32.h),Vv32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_CVI_VV_LATE,A_NOTE_SHIFT_RESOURCE),"Count leading bits and add",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.h[i] = fMAX(fCL1_2(~VuV.h[i]),fCL1_2(VuV.h[i])) + VvV.h[i]; } })

EXTINSN(V6_vpopcounth,"Vd32.h=vpopcount(Vu32.h)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VS,A_NOTE_SHIFT_RESOURCE),"Count Leading Zeros in Word",
{ fHIDE(int i;) fVFOREACH(16, i) { VdV.uh[i]=fCOUNTONES_2(VuV.uh[i]); } })

EXTINSN(V6_vhist,"vhist",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vhist instruction",
{ fHIDE(mmvector_t inputVec;) inputVec=fTMPVDATA(); fUARCH_NOTE_PUMP_4X(); fHIDE(int lane;) DECL_EXT_VREG(tmp); fVFOREACH(128, lane) { for (fHIDE(int )i=0; i<128/8; ++i) { unsigned char value = inputVec.ub[(128/8)*lane+i]; unsigned char regno = value>>3; unsigned char element = value & 7; int vreg_idx = (128/16)*lane+(element); READ_EXT_VREG(regno,tmp,0); tmp.uh[vreg_idx]++; tmp.uw_ext[vreg_idx/8] = V_EXTENDED_WORDVAL; WRITE_EXT_VREG(regno,tmp,EXT_NEW); } }; })

EXTINSN(V6_vhistq,"vhist(Qv4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vhist instruction",
{ fHIDE(mmvector_t inputVec;) inputVec=fTMPVDATA(); fUARCH_NOTE_PUMP_4X(); fHIDE(int lane;) DECL_EXT_VREG(tmp); fVFOREACH(128, lane) { for (fHIDE(int )i=0; i<128/8; ++i) { unsigned char value = inputVec.ub[(128/8)*lane+i]; unsigned char regno = value>>3; unsigned char element = value & 7; int vreg_idx = (128/16)*lane+(element); READ_EXT_VREG(regno,tmp,0); if (fGETQBIT(QvV,128/8*lane+i)) { tmp.uh[vreg_idx]++; tmp.uw_ext[vreg_idx/8] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(regno,tmp,EXT_NEW); } }; })

EXTINSN(V6_vwhist256,"vwhist256",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram halfword counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>0) & (~7)) | ((bucket>>0) & 7); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); { weight = fGETUBYTE(1,input.h[i]); } { tmp.uh[elindex] = (tmp.uh[elindex] + weight); tmp.uw_ext[elindex/(8>>0)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist256q,"vwhist256(Qv4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram halfword counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>0) & (~7)) | ((bucket>>0) & 7); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); { weight = fGETUBYTE(1,input.h[i]); } if (fGETQBIT(QvV,2*i)) { tmp.uh[elindex] = (tmp.uh[elindex] + weight); tmp.uw_ext[elindex/(8>>0)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist256_sat,"vwhist256:sat",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram halfword counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>0) & (~7)) | ((bucket>>0) & 7); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); { weight = fGETUBYTE(1,input.h[i]); } { tmp.uh[elindex] = fVSATUH(tmp.uh[elindex] + weight); tmp.uw_ext[elindex/(8>>0)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist256q_sat,"vwhist256(Qv4):sat",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram halfword counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>0) & (~7)) | ((bucket>>0) & 7); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); { weight = fGETUBYTE(1,input.h[i]); } if (fGETQBIT(QvV,2*i)) { tmp.uh[elindex] = fVSATUH(tmp.uh[elindex] + weight); tmp.uw_ext[elindex/(8>>0)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist128,"vwhist128",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram word counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>1) & (~3)) | ((bucket>>1) & 3); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); { weight = fGETUBYTE(1,input.h[i]); } { tmp.uw[elindex] = (tmp.uw[elindex] + weight); tmp.uw_ext[elindex/(8>>1)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist128q,"vwhist128(Qv4)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram word counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>1) & (~3)) | ((bucket>>1) & 3); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); { weight = fGETUBYTE(1,input.h[i]); } if (fGETQBIT(QvV,2*i)) { tmp.uw[elindex] = (tmp.uw[elindex] + weight); tmp.uw_ext[elindex/(8>>1)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist128m,"vwhist128(#u1)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram word counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>1) & (~3)) | ((bucket>>1) & 3); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); if ((bucket & 1) == uiV) { weight = fGETUBYTE(1,input.h[i]); } { tmp.uw[elindex] = (tmp.uw[elindex] + weight); tmp.uw_ext[elindex/(8>>1)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vwhist128qm,"vwhist128(Qv4,#u1)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_4SLOT,A_CVI_REQUIRES_TMPLOAD),"vector weighted histogram word counters",
fHIDE(mmvector_t input;) input = fTMPVDATA(); { fHIDE(int i;) fVFOREACH(16, i) { fHIDE(unsigned int) bucket = fGETUBYTE(0,input.h[i]); fHIDE(unsigned int) weight = 0; fHIDE(unsigned int) vindex = (bucket >> 3) & 0x1F; fHIDE(unsigned int) elindex = ((i>>1) & (~3)) | ((bucket>>1) & 3); DECL_EXT_VREG(tmp); READ_EXT_VREG(vindex,tmp,0); if ((bucket & 1) == uiV) { weight = fGETUBYTE(1,input.h[i]); } if (fGETQBIT(QvV,2*i)) { tmp.uw[elindex] = (tmp.uw[elindex] + weight); tmp.uw_ext[elindex/(8>>1)] = V_EXTENDED_WORDVAL; } WRITE_EXT_VREG(vindex,tmp,EXT_NEW); fUARCH_NOTE_PUMP_2X();; } })

EXTINSN(V6_vlutvvb,"Vd32.b=vlut32(Vu32.b,Vv32.b,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP,A_NOTE_PERMUTE_RESOURCE),"vector-vector table lookup",
{ fHIDE(int i;) fVFOREACH(8, i) { fHIDE(fRT8NOTE()) fHIDE(unsigned int idx;) fHIDE(int matchval;) fHIDE(int oddhalf;) matchval = RtV & 0x7; oddhalf = (RtV >> (fVECLOGSIZE()-6)) & 0x1; idx = VuV.ub[i]; VdV.b[i] = ((idx & 0xE0) == (matchval << 5)) ? fGETBYTE(oddhalf,VvV.h[idx % fVELEM(16)]) : 0; ; } })

EXTINSN(V6_vlutvvb_oracc,"Vx32.b|=vlut32(Vu32.b,Vv32.b,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"vector-vector table lookup",
{ fHIDE(int i;) fVFOREACH(8, i) { fHIDE(fRT8NOTE()) fHIDE(unsigned int idx;) fHIDE(int matchval;) fHIDE(int oddhalf;) matchval = RtV & 0x7; oddhalf = (RtV >> (fVECLOGSIZE()-6)) & 0x1; idx = VuV.ub[i]; VxV.b[i] |= ((idx & 0xE0) == (matchval << 5)) ? fGETBYTE(oddhalf,VvV.h[idx % fVELEM(16)]) : 0; ; } })

EXTINSN(V6_vlutvwh,"Vdd32.h=vlut16(Vu32.b,Vv32.h,Rt8)",ATTRIBS(A_EXTENSION,A_CVI,A_CVI_VP_VS,A_NOTE_SHIFT_RESOURCE),"vector-vector table lookup",
{ fHIDE(int i;) fVFOREACH(16, i) { fHIDE(fRT8NOTE()) fHIDE(unsigned int idx;) fHIDE(int matchval;) fHIDE(int oddhalf;) matchval = RtV & 0xF; oddhalf = (RtV >> (fVECLOGSIZE()-6)) & 0x1; idx = fGETUBYTE(0,VuV.uh[i]); VddV.v[0].h[i] = ((idx & 0xF0) == (matchval << 4)) ? fGETHALF(oddhalf,VvV.w[idx % fVELEM(32)]) : 0; idx = fGETUBYTE(1,VuV.uh[i]); VddV.v[1].h[i] = ((idx & 0xF0) == (matchval << 4)) ? fGETHALF(oddhalf,VvV.w[idx % fVELEM(32)]) : 0; ; } })

