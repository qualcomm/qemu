Q6INSN(S5_vasrhrnd,"Rdd32=vasrh(Rss32,#u4):raw",ATTRIBS(),"Vector Arithmetic Shift Right by Immediate with Round",{ fHIDE(int i;) for (i=0;i<4;i++) { fSETHALF(i,RddV, ( ((fGETHALF(i,RssV) >> uiV)+1)>>1 )); } })
Q6INSN(S5_vasrhrnd_goodsyntax,"Rdd32=vasrh(Rss32,#u4):rnd",ATTRIBS(A_MAPPING,A_CONDMAPPING,A_ARCHV5),"Conditional Mapping from Rdd32=vasrh(Rss32,#u4):rnd to either Rdd32=Rss32 or Rdd32=vasrh(Rss32,#u4-1):raw",fCOND_ASM_MAP("Rdd32=vasrh(Rss32,#u4):rnd","#u4==0","Rdd32=Rss32","Rdd32=vasrh(Rss32,#u4-1):raw"))
