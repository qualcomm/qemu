Q6INSN(Y2_k0unlock,"k0unlock",ATTRIBS(A_PRIV,A_NOTE_PRIV,A_NOTE_NOPACKET,A_RESTRICT_NOPACKET),"Unlock K0",{fCLEAR_K0_LOCK();})
