Q6INSN(S5_asrhub_rnd_sat_goodsyntax,"Rd32=vasrhub(Rss32,#u4):rnd:sat",ATTRIBS(A_MAPPING,A_CONDMAPPING,A_ARCHV5),"Conditional Mapping from Rd32=vasrhub(Rss32,#u4):rnd:sat to either Rd32=vsathub(Rss32) or Rd32=vasrhub(Rss32,#u4-1):raw",fCOND_ASM_MAP("Rd32=vasrhub(Rss32,#u4):rnd:sat","#u4==0","Rd32=vsathub(Rss32)","Rd32=vasrhub(Rss32,#u4-1):raw"))
