Q6INSN(L6_deallocframe_map_to_raw,"deallocframe",ATTRIBS(A_MAPPING),"Mapping from deallocframe to r31:30=deallocframe(r30):raw",fASM_MAP("deallocframe","r31:30=deallocframe(r30):raw"))
Q6INSN(L4_return,"Rdd32=dealloc_return(Rs32):raw",ATTRIBS(A_REGWRSIZE_8B,A_ROPS_2,A_JUMP,A_INDIRECT,A_RESTRICT_LOOP_LA,A_RESTRICT_COF_MAX1,A_MEMSIZE_8B,A_LOAD,A_RESTRICT_COF_MAX1,A_RESTRICT_SLOT0ONLY,A_RESTRICT_NOSLOT1_STORE,A_RET_TYPE,A_DEALLOCRET),"Deallocate stack frame and return",{ fHIDE(size8u_t tmp;) fEA_REG(RsV); fLOAD(1,8,u,EA,tmp); RddV = fFRAME_UNSCRAMBLE(tmp); fWRITE_SP(EA+8); fJUMPR(REG_LR,fGETWORD(1,RddV),COF_TYPE_JUMPR);})
Q6INSN(L6_return_map_to_raw,"dealloc_return",ATTRIBS(A_MAPPING),"Mapping from dealloc_return to r31:30=dealloc_return(r30):raw",fASM_MAP("dealloc_return","r31:30=dealloc_return(r30):raw"))
Q6INSN(L4_return_t,"if (Pv4) Rdd32=dealloc_return(Rs32):raw",ATTRIBS(A_ROPS_2,A_MEMSIZE_8B,A_LOAD,A_RESTRICT_COF_MAX1,A_RESTRICT_SLOT0ONLY,A_RESTRICT_NOSLOT1_STORE,A_RET_TYPE,A_DEALLOCRET,A_JUMP,A_INDIRECT,A_CJUMP,A_DOTOLD,A_RESTRICT_LOOP_LA,A_RESTRICT_COF_MAX1,A_PRED_BIT_7),"deallocate stack frame and return",{ fHIDE(size8u_t tmp;) fBRANCH_SPECULATE_STALL(fLSBOLD(PvV),,SPECULATE_NOT_TAKEN,7,0); fEA_REG(RsV); if (fLSBOLD(PvV)) { fLOAD(1,8,u,EA,tmp); RddV = fFRAME_UNSCRAMBLE(tmp); fWRITE_SP(EA+8); fJUMPR(REG_LR,fGETWORD(1,RddV),COF_TYPE_JUMPR); } else { LOAD_CANCEL(EA); } })
Q6INSN(L4_return_f,"if (!Pv4) Rdd32=dealloc_return(Rs32):raw",ATTRIBS(A_ROPS_2,A_MEMSIZE_8B,A_LOAD,A_RESTRICT_COF_MAX1,A_RESTRICT_SLOT0ONLY,A_RESTRICT_NOSLOT1_STORE,A_RET_TYPE,A_DEALLOCRET,A_JUMP,A_INDIRECT,A_CJUMP,A_DOTOLD,A_RESTRICT_LOOP_LA,A_RESTRICT_COF_MAX1,A_PRED_BIT_7),"deallocate stack frame and return",{ fHIDE(size8u_t tmp;) fBRANCH_SPECULATE_STALL(fLSBOLDNOT(PvV),,SPECULATE_NOT_TAKEN,7,0); fEA_REG(RsV); if (fLSBOLDNOT(PvV)) { fLOAD(1,8,u,EA,tmp); RddV = fFRAME_UNSCRAMBLE(tmp); fWRITE_SP(EA+8); fJUMPR(REG_LR,fGETWORD(1,RddV),COF_TYPE_JUMPR); } else { LOAD_CANCEL(EA); } })
