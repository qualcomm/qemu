config HEX_DSP
    bool
    default y
    depends on HEXAGON && TCG
    imply PTIMER
    select L2VIC
    select ARM_COMPATIBLE_SEMIHOSTING
    select TCSR
    select DSPSS_PUB

config HEX_VIRT
    bool
    default y
    depends on HEX_DSP && FDT
    select DEVICE_TREE
    select VIRTIO_MMIO
    select PL011
    select X_QUP_GENI_UART_RUST if HAVE_RUST
    select QUP_WRAPPER if HAVE_RUST
    select VIRTIO_BLK
    select VIRTIO_SCSI
