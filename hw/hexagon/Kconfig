config HEX_DSP
    bool
    default y
    depends on HEXAGON && TCG
    imply PTIMER
    select L2VIC  # Vector PIC
    select QTIMER
    select ARM_COMPATIBLE_SEMIHOSTING
    select TCSR

config HEX_VIRT
    bool
    default y
    depends on HEX_DSP && FDT
    select DEVICE_TREE
    select VIRTIO_MMIO
    select PL011
    select VIRTIO_BLK
    select VIRTIO_SCSI
