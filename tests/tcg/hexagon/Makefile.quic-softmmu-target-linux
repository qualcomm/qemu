ieee_fp.o: EXTRA_TEST_CFLAGS= -mhvx -mhvx-length=128B -mhvx-ieee-fp
coproc coproc.o: EXTRA_TEST_CFLAGS= -mhmx -mv81
coproc_conv.o: EXTRA_TEST_CFLAGS= -mhmx
coproc_conv_asm.o: EXTRA_TEST_CFLAGS= -mhmx
