run-coproc:QEMU_EXTRA_OPTS=-M sim_coproc
run-coproc_conv:QEMU_EXTRA_OPTS=-M sim_coproc
run-coproc_range:QEMU_EXTRA_OPTS=-M V68N_1024
run-coproc_conv_fp16:QEMU_EXTRA_OPTS=-M sim_coproc

run-vid-group: vid-group
run-swi_wait: swi_wait
run-tlblock: tlblock
run-vid-group: vid-group
run-coproc:coproc
run-coproc_conv:coproc_conv
run-coproc_range:coproc_range

run-gregs: gregs
	$(call run-test, $<, $(QEMU) -d unimp $(QEMU_OPTS) $< 2> _$<.stderr, \
		"$< on $(TARGET_NAME)") || { cat _$<.stderr; exit 1; }
	grep -E 'Warning: (guest register|ignoring write to guest register)' \
		_$<.stderr > _$<.stderr.filtered
	diff $(HEXAGON_SYSTEM_SRC)/expected-gregs-warnings.txt _$<.stderr.filtered

# Test combinations, with expected output separated by a ':'
#
REV_TEST_COMBINATIONS="-M V69NA_1024           : 0x69" \
		      "-cpu any                : 0x73" \
		      "-cpu v69                : 0x69" \
		      "-cpu v73 -M V69NA_1024  : 0x73" \
		      "-cpu v69 -M V73NA_1024  : 0x69" \
		      "-cpu any -M V69NA_1024  : 0x69" \
		      "-cpu any -M V73NA_1024  : 0x73"

run-rev: rev
	@i=0; \
	ret=0; \
	for comb in $(REV_TEST_COMBINATIONS); do \
		opt="$$(echo "$$comb" | cut -d: -f1)"; \
		exp="$$(echo "$$comb" | cut -d: -f2)"; \
		echo "$< on $(TARGET_NAME) ($$i)"; \
		( \
			if test -n "$(V)"; then set -x; fi; \
			$(QEMU) $(QEMU_OPTS) $< $$opt >$@.$$i.out 2>$@.$$i.err  \
		) && \
		grep -qF $$exp $@.$$i.out; \
		err=$$?; \
		if test $$exp != 0x73; then \
			grep -q 'warning: using .* cpu but binary is for v73' $@.$$i.err; \
			err=$$(($$err + $$?)); \
		fi; \
		if test $$err -eq 0; then \
			echo "  rev test $$i: OK"; \
		else \
			echo "  rev test $$i: FAIL"; \
			ret=1; \
		fi; \
		i=$$(($$i + 1)); \
	done; \
	exit $$ret

# Run some tests with paranoid-commit-state turned on

ifeq ($(OVERRIDE_OPTS),)
run-test-extra = $(call run-test, $1, $2, $3)
else
# If OVERRIDE_OPTS is defined, we skip tests using custom options that
# could interfere with OVERRIDE_OPTS
define run-test-extra
	echo "WARNING: OVERRIDE_OPTS defined, SKIPPING '$3'"
endef
endif

ICOUNT_OPTS=-icount auto
run-tlblock run-swi_wait run-vid-group:
	$(call run-test, $<, $(QEMU) $(QEMU_OPTS) $<,"$< on $(TARGET_NAME)")
	$(call run-test-extra, $<, $(QEMU) $(QEMU_OPTS) $< $(ICOUNT_OPTS),"$< on $(TARGET_NAME) icount")

run-coproc_conv_fp16: coproc_conv_fp16
	$(call run-test, $<, $(QEMU) $(QEMU_OPTS)  $< --append "2 2 2 coproc_input_fp16.dat coproc_output_fp16.dat","$< on $(TARGET_NAME)")

ifneq ($(HAVE_HEXAGON_LLDB_BIN),)
# hexagon-lldb starts qemu with an empty environment. To bypass that, we create
# a wrapper script which properly sets the environment before invoking qemu.
.PHONY: FORCE
qemu-wrapper-for-lldb: FORCE
	{ echo '#!/bin/bash' && \
	  export -p && \
	  echo '"$(QEMU)"' '"$$@"'; } >$@ && \
	chmod +x $@

run-and-check-pass = $(call run-test, $1, \
	bash -c "{ $2 | tee /dev/fd/8 $1.out | grep -q '^PASS$$'; } 8>&1", $3)

run-lldb = $(call run-and-check-pass, $1, \
	     $(HAVE_HEXAGON_LLDB_BIN) --no-lldbinit --batch \
	     --source $(HEXAGON_SYSTEM_SRC)/lldbscripts/$2 \
	     $< -- $(filter-out -kernel,$(QEMU_OPTS)), $3)

run-lldb-revcon run-lldb-reg-reads run-lldb-reg-writes: export LLDB_HEXAGON_USE_QEMU = 1
run-lldb-revcon run-lldb-reg-reads run-lldb-reg-writes: export LLDB_HEXAGON_QEMU_PATH = qemu-wrapper-for-lldb

run-lldb-revcon: simple-assign qemu-wrapper-for-lldb
	$(call run-lldb,$@,test-revcon.lldb,"basic qemu revcon test")

reg-reads: reg-reads.o
reg-reads.o: reg-reads.c timer.h pmu.h
reg-reads.o: EXTRA_TEST_CFLAGS=-DCSR_BASE=0xfc900000 -mhvx -O0 -g
reg-reads: EXTRA_TEST_CFLAGS=-O0 -g

run-lldb-reg-reads: reg-reads qemu-wrapper-for-lldb
	$(call run-lldb,$@,test-reg-reads.lldb,"gdbstub reg reading test")
	$(call quiet-command, grep -q "r00* = 0xdeadbeef" $@.out, "GREP", "gpr");
	$(call quiet-command, awk '!/timerlo = 0x[0]{8}/ && /timerlo = 0x[0-9a-f]{8}/' $@.out, "GREP", "sreg");
	$(call quiet-command, grep -q "gpmucnt0 = 0x00000002" $@.out, "GREP", "greg");
	$(call quiet-command, grep -q "upmucnt0 = 0x00000002" $@.out, "GREP", "creg");

run-lldb-reg-writes: reg-writes qemu-wrapper-for-lldb
	$(call run-lldb,$@,test-reg-writes.lldb,"gdbstub reg writing test")

EXTRA_RUNS += run-lldb-revcon run-lldb-reg-reads run-lldb-reg-writes
endif # have LLDB
