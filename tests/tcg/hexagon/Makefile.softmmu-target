# -*- Mode: makefile -*-
#
# Hexagon SoftMMU tests - included from tests/tcg/Makefile
#

HEXAGON_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/hexagon/system

# Set search path for all sources
VPATH += $(HEXAGON_SYSTEM_SRC)

########### Compiler
#
# Use the hexagon-unknown-none-elf toolchain which bundles picolibc and
# crt0-semihost.  Pass --no-default-config so that the .cfg file shipped
# with the toolchain (which targets hexagon-sim via libh2) is not used;
# instead we supply the relevant flags explicitly.
#
# config-target.mak sets CC to the docker-wrapped hexagon-unknown-linux-musl
# compiler.  Derive the none-elf compiler from it by substituting the
# compiler name; this preserves the docker.py wrapper when present.  If CC
# was not set by config-target.mak the substitution is a no-op and the bare
# compiler name is used directly.
CC := $(subst hexagon-unknown-linux-musl-clang,hexagon-unknown-none-elf-clang,$(CC))

########### Picolibc sysroot
#
# The clang driver exposes where it installed crt0-semihost.o via
# -print-file-name.  Stripping the trailing lib/v68/G0/crt0-semihost.o
# gives us the picolibc sysroot.
#
_CRT0 := $(shell $(CC) -print-file-name=crt0-semihost.o)
PICOLIBC_SYSROOT := $(patsubst %/lib/v68/G0/crt0-semihost.o,%,$(_CRT0))
PICOLIBC_V73 = $(PICOLIBC_SYSROOT)/lib/v73/G0

########### Compiling options
CFLAGS = \
	--no-default-config \
	-target hexagon-unknown-none-elf \
	-mcpu=hexagonv73 \
	-G0 -fno-pic -fno-PIE -ffreestanding -fuse-init-array \
	-nostdlibinc -isystem $(PICOLIBC_SYSROOT)/include \
	-O0 -g -Werror

# Linker flags: use ld.lld directly, bypassing the ld.eld wrapper which
# targets hexagon-sim.  Provide picolibc crt0-semihost.o for startup and
# our linker script that is compatible with ld.lld.
LDFLAGS = \
	--ld-path=hexagon-unknown-none-elf-ld.lld \
	-nostartfiles -nodefaultlibs \
	-L$(PICOLIBC_V73) \
	-Wl,-T,$(HEXAGON_SYSTEM_SRC)/hexagon-standalone.ld \
	$(PICOLIBC_V73)/crt0-semihost.o \
	-lc -lm -lsemihost -lclang_rt.builtins

########### QEMU options
QEMU_BASE_MACHINE=-M V66G_1024 \
	-cpu v66,usefs=$(SRC_PATH)/tests/tcg/hexagon/system
QEMU_OPTS+=-display none

QEMU_OPTS+=$(QEMU_BASE_MACHINE) -kernel

TESTS += \
	standalone_hw \
	tlb-miss-tlblock \
	sysreg-tb-end \
	$()

# Build and link the tests
echo-and-run = echo $(1) && $(1)
define build_fn
    @if test "$(3)" = LINK; then extra="$(LDFLAGS)"; else extra=-c; fi && \
    $(call echo-and-run, $(CC) $(CFLAGS) $(1) -o $(2) $$extra)
endef

%.o: %.S
	$(call build_fn,$<,$@)
%.o: %.c
	$(call build_fn,$<,$@)

standalone_hw: standalone_hw.o
	$(call build_fn,$^,$@,LINK)

sysreg-tb-end: sysreg-tb-end.o
	$(call build_fn,$^,$@,LINK)

############# Custom build options

# sysreg-tb-end reports its result over the PL011 UART (at 0x10000000)
# rather than via the semihosting exit code: it prints "PASS" on success and
# "FAIL" (or nothing, if the translator regresses and the guest hangs) on
# failure.  Capture the UART to a file and require "PASS" to appear.
run-sysreg-tb-end: sysreg-tb-end
	$(call quiet-command, \
		timeout -s KILL --foreground $(TIMEOUT) \
			$(QEMU) $(QEMU_OPTS) $< -serial file:$<.uart \
			< /dev/null > /dev/null 2>&1; \
		grep -q '^PASS' $<.uart, \
		TEST, $< via UART)

# tlb-miss-tlblock uses its own entry point and memory layout
tlb-miss-tlblock: tlb-miss-tlblock.o
	$(CC) $(CFLAGS) $< -o $@ \
		-nostartfiles -nodefaultlibs \
		-Wl,-Ttext,0x9b800000 -Wl,-entry,0x9b800000
