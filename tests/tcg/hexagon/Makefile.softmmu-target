# -*- Mode: makefile -*-
#
# Hexagon SoftMMU tests - included from tests/tcg/Makefile
#

HEXAGON_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/hexagon/system

# Set search path for all sources
VPATH 		+= $(HEXAGON_SYSTEM_SRC)

########### Compiling options
CC=hexagon-unknown-linux-musl-clang
# We force -O0 to avoid optimizations that would break the
# libc simplifications we made at min_libc.c
#
CFLAGS=-mv73 -G0 -nodefaultlibs -nostdlib -static -fno-PIC -O0 -Werror
LDFLAGS=-lclang_rt.builtins-hexagon

########### QEMU options
QEMU_BASE_MACHINE=-M sim -cpu any,count-gcycle-xt=on,cacheop-exceptions=true,usefs=$(SRC_PATH)/tests/tcg/hexagon/system
QEMU_OPTS+=-display none
QEMU_EXTRA_OPTS=
# Set this before running make if you want to run tests with specific options,
# such as MTTCG.
OVERRIDE_OPTS?=
QEMU_OPTS+=$(QEMU_BASE_MACHINE) $(QEMU_EXTRA_OPTS) $(OVERRIDE_OPTS) -kernel
PARANOID_OPTS=-cpu any,paranoid-commit-state=true -display none

TESTS += \
	tlb-miss-tlblock \
	$()

include $(SRC_PATH)/tests/tcg/hexagon/Makefile.quic-softmmu-target

# Build and link the tests
echo-and-run = echo $(1) && $(1)
define build_fn
    @if test "$(3)" = LINK; then extra="$(LDFLAGS)"; else extra=-c; fi && \
    $(call echo-and-run, $(CC) $(CFLAGS) $(EXTRA_TEST_CFLAGS) \
        $(1) -o $(2) $$extra)
endef

$(TESTS):
	$(call build_fn,$^,$@,LINK)

%.o: %.S
	$(call build_fn,$<,$@)
%.o: %.c
	$(call build_fn,$<,$@)
%.o: %.cpp
	$(call build_fn,$<,$@)

############# Custom build options


# We don't want to link this one with crt0 files
tlb-miss-tlblock: tlb-miss-tlblock.o
	$(CC) $(CFLAGS) $< -o $@ -nostartfiles -Wl,-Ttext,0x9b800000 -Wl,-entry,0x9b800000
